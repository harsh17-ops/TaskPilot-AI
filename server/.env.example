MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# TaskPilot AI Reminder & n8n Integration Settings
MY_EMAIL=user@example.com
DEFAULT_TIMEZONE=Asia/Kolkata
N8N_BASE_URL=http://localhost:5678
N8N_AUTOMATION_SECRET=replace-with-a-secure-random-integration-key-min-16-chars

# SMTP Email Dispatch (optional if configured directly in n8n)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your-app-password

# AI Model Configuration (for AI summaries and assistant)
AI_PROVIDER_API_KEY=your-gemini-or-openai-api-key
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
